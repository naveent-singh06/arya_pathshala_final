# ARYA PATHSHALA - environment variables (names only; never commit real values).
# Copy to .env.local for local work, and add the same names in Vercel -> Project Settings -> Environment Variables.

# ---------- Browser (public by design; these are embedded in the built website) ----------
# Use the values from your existing Firebase project. Do not change them.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Leave empty. The API is served from the same domain as the website on Vercel
# (and by `vercel dev` locally). The API does not send CORS headers yet, so pointing
# this at a different origin will be blocked by the browser.
REACT_APP_API_BASE_URL=

# ---------- Server only (SECRET - never prefix these with REACT_APP_) ----------
# AI provider. Any OpenAI-compatible chat-completions API works.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Optional tuning
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_MS=55000

# Per-student usage limits
TUTOR_RATE_PER_MINUTE=8
TUTOR_DAILY_LIMIT=100

# Firebase Admin credentials, used to verify student sign-ins and store usage counters.
# Paste the service-account JSON (or the same JSON base64-encoded) as ONE value.
FIREBASE_SERVICE_ACCOUNT_JSON=
